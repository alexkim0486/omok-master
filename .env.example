# 공부인(gongbuin)과 동일한 Supabase 프로젝트를 가리킵니다 (단일계정 SSO).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# 비로그인 사용자가 로그인하러 이동할 공부인 앱 URL
NEXT_PUBLIC_GONGBUIN_URL=https://<gongbuin-app-domain>

# (배포) 서브도메인 SSO를 쓸 때만. 예: .gongbuin.kr  (로컬은 비움)
# NEXT_PUBLIC_COOKIE_DOMAIN=.<root-domain>
